# NPM Publishing Configuration
# Exclude development and build artifacts from npm package

# Version control
.git/
.gitignore

# Dependencies
node_modules/

# Build artifacts
build/
.gradle/
*.log

# Android local config
local.properties

# macOS
.DS_Store

# Development scripts
scripts/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Test files
__tests__/
*.test.js
*.spec.js

# Platform SDK binaries — do NOT include in npm package; they are downloaded during postinstall
android/Flir/libs/
!android/Flir/libs/.gitkeep
ios/Flir/Frameworks/
!ios/Flir/Frameworks/.gitkeep
# Exclude podspecs from the published npm package to avoid duplicate CocoaPods entries
Flir.podspec

ios/podspecs/
!ios/podspecs/.gitkeep
docs/